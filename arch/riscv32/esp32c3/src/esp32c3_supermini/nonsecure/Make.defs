HEAD_ASRC =

CMN_ASRCS =
CMN_CSRCS =

CHIP_ASRCS_NS = ../../esp-hal/esp_startup.S \
                $(TOPDIR)/freertos/portable/GCC/RISC-V/portASM.S

CHIP_CSRCS_NS = main_ns.c \
                printf.c \
                ../../esp-hal/esp_uart.c \
                ../../esp-hal/esp_systimer.c \
                ../../esp-hal/esp_gpio.c \
                ../../esp-hal/esp_freertos_port.c

# TEE Client hello_world CA is optional; Secure World not in Phase 1.
